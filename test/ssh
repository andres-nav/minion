#!/bin/sh
# Stands in for ssh in the e2e test: runs the remote command on this machine,
# from $HOME (or $E2E_REMOTE_HOME) and with a clean environment, as sshd would. It ignores the options
# and has no control master (-O and -N fail). A host ending in .invalid can't be reached.
while [ $# -gt 0 ]; do
  case $1 in
    -O | -N) exit 255 ;;
    -o | -p | -l | -i | -F | -J) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
case $1 in *.invalid) echo "ssh: Could not resolve hostname $1" >&2; exit 255 ;; esac
shift
[ $# -gt 0 ] || exit 255
HOME=${E2E_REMOTE_HOME:-$HOME}
cd "$HOME" && exec env -i HOME="$HOME" PATH="$PATH" TZ="${TZ:-}" sh -c "$*"
